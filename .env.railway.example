# Variables para Railway (servicio backend)
# =============================================================================
NODE_ENV=production

MONGO_URI=

# Upstash — copia tal cual desde Connect → REST (sin comillas en Railway)
UPSTASH_REDIS_REST_URL=https://hardy-bengal-140703.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Alternativa: URL TCP directa (Connect → TCP)
# REDIS_URL=rediss://default:TOKEN@hardy-bengal-140703.upstash.io:6379

# NO uses REDIS_HOST / REDIS_PORT con Upstash

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PUBLIC_APP_URL=https://tu-frontend.up.railway.app
PUBLIC_API_URL=https://bartender-production-f6e0.up.railway.app
QR_BASE_URL=https://tu-frontend.up.railway.app
CORS_ORIGINS=https://tu-frontend.up.railway.app

API_PREFIX=api
YOUTUBE_API_KEY=
UPLOAD_DIR=/app/uploads
MERCADOPAGO_ACCESS_TOKEN=

# =============================================================================
# FRONTEND — servicio Railway (Root Directory = frontend)
# Builder: Dockerfile.railway (NO frontend/Dockerfile ni Dockerfile de compose)
#
# Variables de BUILD:
#   VITE_API_URL=https://bartender-production-f6e0.up.railway.app
#   VITE_SOCKET_URL=https://bartender-production-f6e0.up.railway.app
#   VITE_YOUTUBE_API_KEY=...
#
# Alternativa desde raíz del repo: Dockerfile Path = Dockerfile.frontend, Root vacío
# =============================================================================