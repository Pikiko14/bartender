# Variables para Railway (backend). Copia a Variables del servicio en el dashboard.
# =============================================================================
NODE_ENV=production

# MongoDB y Redis — usa los plugins de Railway o URLs externas
MONGO_URI=mongodb://...
REDIS_HOST=...
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — genera secretos fuertes (obligatorio en producción)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# URLs públicas (dominio del frontend en Railway)
PUBLIC_APP_URL=https://tu-frontend.up.railway.app
QR_BASE_URL=https://tu-frontend.up.railway.app
CORS_ORIGINS=https://tu-frontend.up.railway.app

API_PREFIX=api
YOUTUBE_API_KEY=
UPLOAD_DIR=/app/uploads

# Mercado Pago (opcional)
MERCADOPAGO_ACCESS_TOKEN=

# NO hace falta BACKEND_PORT ni PORT — Railway inyecta PORT automáticamente
