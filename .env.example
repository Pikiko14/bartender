# ============================================================
# BARTENDER - Variables de entorno (ejemplo)
# Copia este archivo a `.env` y ajusta los valores.
# ============================================================

# ---- General ----
NODE_ENV=development
APP_NAME=Bartender
PUBLIC_APP_URL=http://localhost:5173

# ---- Backend ----
BACKEND_PORT=3000
API_PREFIX=api
# URL pública del backend (usada por el frontend / sockets)
PUBLIC_API_URL=http://localhost:3000

# ---- MongoDB ----
# Hostnames `mongo` / `redis` sirven para docker-compose; fuera de Docker el backend usa localhost.
MONGO_URI=mongodb://mongo:27017/bartender
MONGO_INITDB_DATABASE=bartender

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_ACCESS_SECRET=super_secret_access_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=super_secret_refresh_change_me
JWT_REFRESH_TTL=7d

# ---- Seguridad ----
# Orígenes permitidos CORS, separados por coma
CORS_ORIGINS=http://localhost:5173
# Rate limit global (ventana en segundos / límite de requests)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ---- QR ----
# Base usada para generar las URLs de las mesas: {QR_BASE_URL}/b/{slug}/table/{tableSlug}
QR_BASE_URL=http://localhost:5173

# ---- YouTube ----
YOUTUBE_API_KEY=your_youtube_data_api_key

# ---- Uploads ----
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880

# ---- Mercado Pago (Checkout Pro) ----
# Token de prueba (TEST-...) o producción desde https://www.mercadopago.com.co/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-your_access_token

# ---- Frontend (Vite) ----
# Vite lee estas variables desde este mismo `.env` (raíz del monorepo).
# En dev puedes dejarlas vacías: Vite proxya /api y /socket.io al backend.
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=
VITE_YOUTUBE_API_KEY=your_youtube_data_api_key
